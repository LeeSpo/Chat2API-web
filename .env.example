# Bind address. Use 0.0.0.0 to accept connections from outside the host.
HOST=0.0.0.0

# Port for the unified web UI + OpenAI-compatible proxy.
PORT=8080

# Optional. If set, first-run password setup is skipped and this secret
# authenticates the management API immediately.
# Generate one with: openssl rand -hex 32
# CHAT2API_MANAGEMENT_SECRET=

# Set to 1 to disable the Management API and web UI auth surface.
# CHAT2API_DISABLE_MANAGEMENT_API=

# Set to 1 to disable bookmarklet OAuth ingest.
# CHAT2API_DISABLE_BOOKMARKLET=

# Pin the credential encryption key. Without this Chat2API auto-generates one
# under CHAT2API_DATA_DIR. CHAT2API_STORAGE_ENCRYPTION_KEY is accepted as an alias.
# CHAT2API_ENCRYPTION_KEY=

# Persist config, accounts, and logs. Docker compose mounts this at /data.
# CHAT2API_DATA_DIR=/data

# Compose image override. Leave unset to build/tag locally as chat2api:latest.
# CHAT2API_IMAGE=ghcr.io/leespo/chat2api-web:latest
